{% extends 'base.html.twig' %}

{% block title %}Confirmation de commande - ARTMAD{% endblock %}

{% block breadcrumb %}
<!-- ...:::: Start Breadcrumb Section:::... -->
<div class="breadcrumb-section breadcrumb-bg-color--golden">
    <div class="breadcrumb-wrapper">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h3 class="breadcrumb-title">Confirmation de commande</h3>
                    <div class="breadcrumb-nav breadcrumb-nav-color--black breadcrumb-nav-hover-color--golden">
                        <nav aria-label="breadcrumb">
                            <ul>
                                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                                <li><a href="{{ path('app_account') }}">Mon compte</a></li>
                                <li class="active" aria-current="page">Confirmation de commande</li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> <!-- ...:::: End Breadcrumb Section:::... -->
{% endblock %}

{% block content %}
<div class="faq-section">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="faq-content" data-aos="fade-up" data-aos-delay="0">
                    <h5 class="title">Bonjour <strong>{{ order.user.firstname }} {{ order.user.lastname }}</strong>.</h5>

                    <p>Nous vous remercions pour votre commande n°<strong>{{ order.reference }}</strong>.<br/>
                    Une confirmation vient de vous être envoyée par email à l'adresse <strong>{{ order.user.email }}</strong><p>

                    <p>Votre  commande sera livrée par <strong>{{ order.carrierName }}</strong> à l'adresse suivante : <br/>
                    <div class="card" style="width: 18rem;">
                        <div class="card-body">
                            {{ order.delivery|raw }}
                        </div>
                    </div>
                    </p>
                    <hr>
                    Pour suivre votre commande. Rendez-vous dans votre <a href="{{ path('app_account') }}">compte</a>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
