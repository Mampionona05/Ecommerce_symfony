<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% block title %} ARTMAD {% endblock %}</title>

    <!-- Bootstrap core CSS -->
    <!-- link href="{{ asset('assets/css/bootstrap.min.css') }}" rel="stylesheet" -->

    <link href="{{ asset('assets/img/favicon.ico') }}" rel="shortcut icon" type="image/png">
    <link href="{{ asset('assets/css/vendor/vendor.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/plugins/plugins.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/style.css') }}" rel="stylesheet">

    {% block javascript %}
    {% endblock %}
</head>

<body>
    <!-- Start Header Area -->
    <header class="header-section d-none d-xl-block">
        <div class="header-wrapper">
            <!-- Start Header Top -->
            <div class="header-top header-top-bg--black section-fluid">
                <div class="container">
                    <div class="col-12 d-flex align-items-center justify-content-between">
                        <div class="header-top-left">
                            <div
                                class="header-top-contact header-top-contact-color--white header-top-contact-hover-color--golden">
                                <a href="tel:0123456789" class="icon-space-right"><i
                                        class="icon-call-in"></i>034 90 009 42</a>
                                <a href="mailto:demo@example.com" class="icon-space-right"><i
                                        class="icon-envelope"></i>rak.herymampionona@gmail.com</a>
                            </div>
                        </div>
                        <div class="header-top-right">
                            <div
                                class="header-top-user-link header-top-user-link-color--white header-top-user-link-hover-color--golden">
                                {% if app.user %}
                                    <a href="{{ path('app_account') }}">Mon compte <small>({{ app.user.firstname }})</small></a>
                                    <a href="{{ path('app_logout') }}">Déconnexion</a>
                                {% else %}
                                    <a href="{{ path('app_login') }}">Connexion</a>
                                    <a href="{{ path('app_register') }}">Inscription</a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- End Header Top -->
            <div class="header-bottom header-bottom-color--golden section-fluid sticky-header sticky-color--golden">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-12 d-flex align-items-center justify-content-between">
                            <!-- Start Header Logo -->
                            <div class="col-lg-2">
                                <div class="logo text-center text-lg-start">
                                    <a href="{{ path('app_home') }}"><img src="{{ asset('assets/img/logo.jpg') }}" width="400px" height="100px" alt=""></a>
                                </div>
                            </div>
                            <!-- End Header Logo -->

                            <!-- Start Header Main Menu -->
                            <div class="main-menu menu-color--black menu-hover-color--golden">
                                <nav>
                                    <ul>
                                        <li>
                                            <a class="active main-menu-link" href="{{ path('app_home') }}">Accueil</a>
                                        </li>
                                        <li>
                                            <a href="{{ path('app_products') }}">Nos produits</a>
                                        </li>
                                        <li>
                                            <a href="{{ path('app_about') }}">A propos de nous</a>
                                        </li>
                                        <li>
                                            <a href="{{ path('app_contact') }}">Contact</a>
                                        </li>
                                        
                                    </ul>
                                </nav>
                            </div>
                            <!-- End Header Main Menu Start -->

                            <!-- Start Header Action Link -->
                            <ul class="header-action-link action-color--black action-hover-color--golden">
                                <li>
                                    <a href="{{ path('app_cart') }}">
                                        <i class="icon-bag"></i>
                                    </a>
                                </li>
                            </ul>
                            <!-- End Header Action Link -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <!-- Start Header Area -->

    {% block breadcrumb %}
    {% endblock %}

    {% if block('carousel') is defined %}
    <!-- Start Hero Slider Section-->
    <div class="hero-slider-section">
        <!-- Slider main container -->
        <div class="hero-slider-active swiper-container">
            <!-- Additional required wrapper -->
            <div class="swiper-wrapper">
                <!-- Start Hero Single Slider Item -->
                <div class="hero-single-slider-item swiper-slide">
                    <!-- Hero Slider Image -->
                    <div class="hero-slider-bg">
                        <img src="assets/img/vannerie1.jpg" height="790px" alt="">
                    </div>
                    <!-- Hero Slider Content -->
                    <div class="hero-slider-wrapper">
                        <div class="container">
                            <div class="row">
                                <div class="col-auto">
                                    <div class="hero-slider-content">
                                        <h2 class="title">Le meilleur vannerie <br/> Arona raphia</h2>
                                        <a href="{{ path('app_products') }}"
                                            class="btn btn-lg btn-outline-golden">acheter maintenant </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div> <!-- End Hero Single Slider Item -->
                <!-- Start Hero Single Slider Item -->
                <div class="hero-single-slider-item swiper-slide">
                    <!-- Hero Slider Image -->
                    <div class="hero-slider-bg">
                        <img src="assets/img/hero-slider.jpg" alt="">
                    </div>
                    <!-- Hero Slider Content>
                    <div class="hero-slider-wrapper">
                        <div class="container">
                            <div class="row">
                                <div class="col-auto">
                                    <div class="hero-slider-content">
                                        <h2 class="title">Le meilleur produit d'art Malagasy</h2>
                                        <a href="{{ path('app_products') }}"
                                            class="btn btn-lg btn-outline-golden">acheter maintenant </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div -->
                </div> <!-- End Hero Single Slider Item -->
            </div>

            <!-- If we need pagination -->
            <div class="swiper-pagination active-color-golden"></div>

            <!-- If we need navigation buttons -->
            <div class="swiper-button-prev d-none d-lg-block"></div>
            <div class="swiper-button-next d-none d-lg-block"></div>
        </div>
    </div>
    <!-- End Hero Slider Section-->
    {% endif %}

    {% block content %}
    {% endblock %}

    <!-- Start Footer Section -->
    <footer class="footer-section footer-bg section-top-gap-100">
        <div class="footer-wrapper">
            <!-- Start Footer Top -->
            <div class="footer-top">
                <div class="container">
                    <div class="row mb-n6">
                        <div class="col-lg-3 col-sm-6 mb-6">
                            <!-- Start Footer Single Item -->
                            <div class="footer-widget-single-item footer-widget-color--golden" data-aos="fade-up"
                                data-aos-delay="0">
                                <h5 class="title">INFORMATION</h5>
                                <ul class="footer-nav">
                                    <li><a href="#">Information sur la livraison</a></li>
                                    <li><a href="#">Conditions & Délai</a></li>
                                    <li><a href="{{ path('app_contact') }}">Contact</a></li>
                                </ul>
                            </div>
                            <!-- End Footer Single Item -->
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-6">
                            <!-- Start Footer Single Item -->
                            <div class="footer-widget-single-item footer-widget-color--golden" data-aos="fade-up"
                                data-aos-delay="200">
                                <h5 class="title">MON COMPTE</h5>
                                <ul class="footer-nav">
                                    {% if app.user %}
                                    <li><a href="{{ path('app_account') }}">Mon compte <small>({{ app.user.firstname }})</small></a></li>
                                    <li><a href="{{ path('app_logout') }}">Déconnexion</a></li>
                                    {% else %}
                                    <li><a href="{{ path('app_login') }}">Connexion</a></li>
                                    <li><a href="{{ path('app_register') }}">Inscription</a></li>
                                    {% endif %}
                                    <li><a href="{{ path('app_cart') }}">Mon panier</a></li>
                                </ul>
                            </div>
                            <!-- End Footer Single Item -->
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-6">
                            <!-- Start Footer Single Item -->
                            <div class="footer-widget-single-item footer-widget-color--golden" data-aos="fade-up"
                                data-aos-delay="400">
                                <h5 class="title">CATEGORIES</h5>
                                <ul class="footer-nav">
                                    <li><a href="{{ path('app_products') }}">Broderies</a></li>
                                    <li><a href="{{ path('app_products') }}">Instrument de musique</a></li>
                                    <li><a href="{{ path('app_products') }}">Poterie</a></li>
                                    <li><a href="{{ path('app_products') }}">Vanerie</a></li>
                                    <li><a href="{{ path('app_products') }}">Landy</a></li>
                                    <li><a href="{{ path('app_products') }}">Sculpture en bois</a></li>
                                    <li><a href="{{ path('app_products') }}">Sculpture en pierre</a></li>
                                </ul>
                            </div>
                            <!-- End Footer Single Item -->
                        </div>
                        <div class="col-lg-3 col-sm-6 mb-6">
                            <!-- Start Footer Single Item -->
                            <div class="footer-widget-single-item footer-widget-color--golden" data-aos="fade-up"
                                data-aos-delay="600">
                                <h5 class="title">A PROPOS DE NOUS</h5>
                                <div class="footer-about">
                                    <p>Nous somme un fournisseur de vente des produits d'art Malagasy.</p>
                                    <address class="address">
                                        <span>Adresse: Notre adresse</span></br>
                                        <span>Email: rak.herymampionona@gmail.com</span>
                                    </address>
                                </div>
                            </div>
                            <!-- End Footer Single Item -->
                        </div>
                    </div>
                </div>
            </div>
            <!-- End Footer Top -->

            <!-- Start Footer Center -->
            <div class="footer-center">
                <div class="container">
                    <div class="row mb-n6">
                        <div class="col-xl-3 col-lg-4 col-md-6 mb-6">
                            <div class="footer-social" data-aos="fade-up" data-aos-delay="0">
                                <h4 class="title">SUIVEZ NOUS</h4>
                                <ul class="footer-social-link">
                                    <li><a href="#"><i class="fa fa-facebook"></i></a></li>
                                    <li><a href="#"><i class="fa fa-twitter"></i></a></li>
                                    <li><a href="#"><i class="fa fa-instagram"></i></a></li>
                                    <li><a href="#"><i class="fa fa-linkedin"></i></a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-xl-7 col-lg-6 col-md-6 mb-6">
                            <div class="footer-newsletter" data-aos="fade-up" data-aos-delay="200">
                                <h4 class="title">NE MANQUEZ PAS LES DERNIÈRES NOUVEAUTÉS</h4>
                                <div class="form-newsletter">
                                    <form action="#" method="post">
                                        <div class="form-fild-newsletter-single-item input-color--golden">
                                            <input type="email" placeholder="Votre adresse email..." required>
                                            <button type="submit">S'ABONNER !</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Start Footer Center -->

            <!-- Start Footer Bottom -->
            <div class="footer-bottom">
                <div class="container">
                    <div
                        class="row justify-content-between align-items-center align-items-center flex-column flex-md-row mb-n6">
                        <div class="col-auto mb-6">
                            <div class="footer-copyright">
                                <p class="copyright-text">&copy; 2023 <a href="index.html">ARTMAD</a>. Made with <i
                                        class="fa fa-heart text-danger"></i> by <a href="#"
                                        target="_blank">Randevteam</a> </p>

                            </div>
                        </div>
                        <div class="col-auto mb-6">
                            <div class="footer-payment">
                                <div class="image">
                                    <img src="assets/img/payment.png" alt="">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Start Footer Bottom -->
        </div>
    </footer>
    <!-- End Footer Section -->

