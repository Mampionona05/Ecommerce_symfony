{% extends 'base.html.twig' %}

{% block title %}Valider ma commande - ARTMAD{% endblock %}

{% block javascript %}
    <script src="https://js.stripe.com/v1/"></script>
{% endblock %}

{% block breadcrumb %}
<!-- ...:::: Start Breadcrumb Section:::... -->
<div class="breadcrumb-section breadcrumb-bg-color--golden">
    <div class="breadcrumb-wrapper">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h3 class="breadcrumb-title">Je passe ma commande</h3>
                    <div class="breadcrumb-nav breadcrumb-nav-color--black breadcrumb-nav-hover-color--golden">
                        <nav aria-label="breadcrumb">
                            <ul>
                                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                                <li><a href="{{ path('app_cart') }}">Pannier</a></li>
                                <li><a href="{{ path('app_order') }}">Recapitulatif</a></li>
                                <li class="active" aria-current="page">Je passe ma commande</li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> <!-- ...:::: End Breadcrumb Section:::... -->
{% endblock %}

{% block content %}
<div class="product-details-section">
	<div class="container">
        <div class="row">
            <div class="col-md-6">
                <strong>Mon adresse de livraison</strong><br/>
                <div class="form-check mt-4">
                    {{ delivery|raw }}
                </div>
                <hr>
                <strong>Mon transporteur</strong><br/>
                <div class="form-check mt-4">
                    {{ carrier.name }}
                    {{ carrier.description }}
                    {{ (carrier.price / 100)|number_format(0, '.', ' ') }} Ar
                </div>
            </div>
            <div class="col-md-6">
                <div class=text-center>
                    <b>Ma commande</b></br>
                </div>
                
                <div class="order-summary">
                    {% set total = null %}
                    {% for key,product in cart %}
                        <div class="row" {% if key > 0 %}mt-2{% endif %}>
                            <div class="col-2">
                                <img src="/imgUploads/{{ product.product.illustration }}" alt="{{ product.product.name }}" height="75px">
                            </div>
                            <div class="col-6">
                                {{ product.product.name }}<br/>
                                <small>
                                    {{ product.product.subtitle }}
                                <br/>
                                    x {{ product.quantity }}
                                </small>
                            </div>
                            <div class="col-2 my-auto">
                                {{ ((product.product.price * product.quantity)/ 100)|number_format(0, '.', ' ') }} Ar
                            </div>
                        </div>
                        {% set total = total + product.product.price * product.quantity %}
                    {% endfor %}
                </div>
                <hr>

                <div class="coupon_inner">
                    <div class="cart_subtotal">
                        <p>Sous-Total</p>
                        <p class="cart_amount">{{ (total / 100)|number_format(0, '.', ' ') }} Ar</p>
                    </div>

                    <div class="cart_subtotal">
                        <p>Livraison</p>
                        <p class="cart_amount">{{ (carrier.price / 100)|number_format(0, '.', ' ') }} Ar</p>
                    </div>
                    <hr>

                    <div class="cart_subtotal">
                        <p>Total</p>
                        <p class="cart_amount">{{ ((total / 100) + (carrier.price / 100))|number_format(0, '.', ' ') }} Ar</p>
                    </div>
                    <div class="product-add-to-cart-btn">
                        <form action="{{ path('app_stripe_create_session', {reference: reference}) }}" method="POST">
                            <button type="submit" id="checkout-button" class="btn btn-block btn-black-default-hover">Payer par stripe | {{ ((total / 100) + (carrier.price / 100))|number_format(0, '.', ' ') }} Ar</button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
{% endblock %}

 
