{% extends 'base.html.twig' %}

{% block title %}Valider ma commande - ARTMAD{% endblock %}

{% block breadcrumb %}
<!-- ...:::: Start Breadcrumb Section:::... -->
<div class="breadcrumb-section breadcrumb-bg-color--golden">
    <div class="breadcrumb-wrapper">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h3 class="breadcrumb-title">Je passe ma commande</h3>
                    <div class="breadcrumb-nav breadcrumb-nav-color--black breadcrumb-nav-hover-color--golden">
                        <nav aria-label="breadcrumb">
                            <ul>
                                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                                <li><a href="{{ path('app_cart') }}">Pannier</a></li>
                                <li class="active" aria-current="page">Je passe ma commande</li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> <!-- ...:::: End Breadcrumb Section:::... -->
{% endblock %}

{% block content %}
<div class="product-details-section">
	<div class="container">
		<div class="row">
            <div class="col-md-6">
                {% set formHtml %}
                    {{ form_start(form, {action:path('app_order_recap')}) }}
                        {{ form_label(form.addresses, 'Choisissez votre adresse de livraison') }}
                        <a class="btn btn-md btn-golden float-right" href="{{ path('app_account_address_add') }}">Ajouter une nouvelle adresse</a>
                    {{ form_end(form) }}
                {% endset %}

                {{ formHtml|replace({'[br]' : '<br/>'})|raw }}
            </div>
            <div class="col-md-6">
                <div class=text-center>
                    <b>Récape de ma commande</b></br>
                    <p>Retrouver le récapitulatif de vos produits</p>
                </div>
                
                <div class="order-summary">
                    {% for key,product in cart %}
                        <div class="row" {% if key > 0 %}mt-2{% endif %}>
                            <div class="col-2">
                                <img src="/imgUploads/{{ product.product.illustration }}" alt="{{ product.product.name }}" height="75px">
                            </div>
                            <div class="col-6">
                                {{ product.product.name }}<br/>
                                <small>{{ product.product.subtitle }}</small>
                            </div>
                            <div class="col-2 my-auto">
                                x {{ product.quantity }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
