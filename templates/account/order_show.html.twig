{% extends 'base.html.twig' %}

{% block title %}Ma commande - ARTMAD{% endblock %}

{% block breadcrumb %}
<!-- ...:::: Start Breadcrumb Section:::... -->
<div class="breadcrumb-section breadcrumb-bg-color--golden">
    <div class="breadcrumb-wrapper">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h3 class="breadcrumb-title">Ma commande</h3>
                    <div class="breadcrumb-nav breadcrumb-nav-color--black breadcrumb-nav-hover-color--golden">
                        <nav aria-label="breadcrumb">
                            <ul>
                                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                                <li><a href="{{ path('app_account') }}">Mon compte</a></li>
                                <li class="active" aria-current="page">Pannier</li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> <!-- ...:::: End Breadcrumb Section:::... -->
{% endblock %}

{% block content %}
    <!-- ...:::: Start Cart Section:::... -->
    <div class="cart-section">
        <!-- Start Coupon Start -->
        <div class="coupon_area">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="coupon_code right" data-aos="fade-up" data-aos-delay="400">
                            <div class="coupon_inner">
                                <div class="cart_subtotal">
                                    <p>Statut de la commande</p>
                                    <p class="cart_amount">
                                        {% if order.state == 1 %}
                                                Paiement accepté
                                        {% elseif order.state == 2 %}
                                            Préparation en cours
                                        {% elseif order.state == 3 %}
                                            Livraison en cours
                                        {% endif %}
                                    </p>
                                </div>

                                <div class="cart_subtotal">
                                    <p>Commande passée le</p>
                                    <p class="cart_amount">{{ order.createdAt|date('d/m/Y') }}</p>
                                </div>

                                <div class="cart_subtotal">
                                    <p>Référence de ma commade</p>
                                    <p class="cart_amount">{{ order.reference }}</p>
                                </div>

                                <div class="cart_subtotal">
                                    <p>Transport choisi</p>
                                    <p class="cart_amount">{{ order.carriername }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div> <!-- End Coupon Start -->

        <!-- Start Cart Table -->
        <div class="cart-table-wrapper" data-aos="fade-up" data-aos-delay="0">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="table_desc">
                            <div class="table_page table-responsive">
                                <table>
                                    <!-- Start Cart Table Head -->
                                    <thead>
                                        <tr>
                                            <th class="product_name">Produit</th>
                                            <th class="product-price">Quantité</th>
                                            <th class="product_quantity">Prix unitaire</th>
                                            <th class="product_total">Total</th>
                                        </tr>
                                    </thead> <!-- End Cart Table Head -->
                                    <tbody>
                                        <!-- Start Cart Single Item-->
                                        {% for product in order.orderDetails %}
                                        <tr>
                                            <td class="product_name">{{ product.product }}</td>
                                            <td class="product-quantity">{{ product.quantity }}</td>
                                            <td class="product_price">{{ (product.price / 100)|number_format(2, ',', '.') }} Ar</td>
                                            <td class="product_total">{{ (product.total / 100)|number_format(2, ',', '.') }} Ar</td>
                                        </tr> <!-- End Cart Single Item-->
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div> <!-- End Cart Table -->

        <!-- Start Coupon Start -->
        <div class="coupon_area">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="coupon_code right" data-aos="fade-up" data-aos-delay="400">
                            <h3>Total</h3>
                            <div class="coupon_inner">
                                <div class="cart_subtotal">
                                    <p>Sous-total</p>
                                    <p class="cart_amount">{{ (order.getTotal / 100)|number_format(2, ',', '.') }} Ar</p>
                                </div>

                                <div class="cart_subtotal">
                                    <p>Livraison</p>
                                    <p class="cart_amount">{{ (order.carrierPrice / 100)|number_format(2, ',', '.') }} Ar</p>
                                </div>

                                <div class="cart_subtotal">
                                    <p>Total</p>
                                    <p class="cart_amount">{{ ((order.getTotal + order.carrierPrice) / 100)|number_format(2, ',', '.') }} Ar</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div> <!-- End Coupon Start -->
    </div> <!-- ...:::: End Cart Section:::... -->
    
{% endblock %}
